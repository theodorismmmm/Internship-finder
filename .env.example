# === Du brauchst KEINE Google-Maps- oder Mapbox-Keys ===
# Karte = Leaflet + OpenStreetMap / CARTO (kostenlos, ohne Key)
# Adresssuche = Nominatim (ohne Key, nur User-Agent)
# Betriebe = Overpass/OSM (ohne Key)
# Praktika = Jobsuche der Bundesagentur für Arbeit

# Öffentliche Client-ID der BA (kein Account nötig):
BA_API_KEY=jobboerse-jobsuche

# User-Agent für Nominatim/Overpass (einfach deine Mail eintragen):
GEO_USER_AGENT=PraktikumsRadar/1.0 (deine@email.de)

# Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
