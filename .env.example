# === Keine Google-Maps / Mapbox Keys nötig ===
# Karte = Leaflet + CARTO Basemaps
# Adresssuche = Nominatim (ohne Key, nur User-Agent)
# Betriebe = Overpass/OSM (ohne Key)
# Praktika = Jobsuche der Bundesagentur für Arbeit

# Öffentliche Client-ID der BA (kein Account nötig):
BA_API_KEY=jobboerse-jobsuche

# User-Agent für Nominatim/Overpass (einfach deine Mail eintragen):
GEO_USER_AGENT=PraktikumsRadar/1.0 (deine@email.de)

# CARTO Basemaps API-Key (Dashboard → API key)
# Raster: https://basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png?key=...
NEXT_PUBLIC_CARTO_API_KEY=your-carto-api-key

# Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
